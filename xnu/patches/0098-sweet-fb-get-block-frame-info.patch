 static uint64_t sweet_fb_logged;        /* selectors already logged (< 64) */
 
+/*
+ * IOMobileFramebufferGetBlock reads a block in chunks. The 0x4d block is a
+ * 1580-byte vendor blob probed by QuartzCore; its contents are not parsed.
+ * Block 0x40 is the 40-byte digital-output-mode record, whose mode/state
+ * fields are uint32 values at offsets 4 and 8.
+ */
+static void
+sweet_fb_get_block(AppleCLCD *fb, uint64_t block, uint64_t offset,
+    void *buffer, size_t size)
+{
+	uint8_t record[40];
+
+	if (buffer == NULL || size == 0 || block != 0x40) {
+		return;
+	}
+	bzero(record, sizeof(record));
+	uint32_t mode = 1;
+	uint32_t state = 1;
+	memcpy(record + 4, &mode, sizeof(mode));
+	memcpy(record + 8, &state, sizeof(state));
+	for (size_t i = 0; i < size; i++) {
+		uint64_t src = offset + i;
+		((uint8_t *)buffer)[i] = src < sizeof(record) ? record[src] : 0;
+	}
+}
