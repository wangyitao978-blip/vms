+/*
+ * Stream the surface's page tables to the host. The host samples and blends
+ * into guest RAM through the shared RAM file, which needs a physical address
+ * per 16 KiB page; nothing else in the guest can supply that mapping.
+ */
+static IOReturn
+sweet_surface_send_map(SweetSurface *s, uint32_t surface, uint32_t *out_pages,
+    addr64_t *out_first)
+{
+	uint32_t total = (uint32_t)((s->allocSize + SWEET_GPU_PAGE_SIZE - 1) >>
+	    SWEET_GPU_PAGE_SHIFT);
+	size_t message_size = 16 + sizeof(struct sweet_gpu_wire_map);
+	unsigned char *message = (unsigned char *)IOMalloc(message_size);
+	if (message == NULL) {
+		return kIOReturnNoMemory;
+	}
+	struct sweet_gpu_wire_header *header =
+	    (struct sweet_gpu_wire_header *)message;
+	struct sweet_gpu_wire_map *map =
+	    (struct sweet_gpu_wire_map *)(message + 16);
+	bzero(map, sizeof(*map));
+	header->magic = SWEET_GPU_WIRE_MAGIC;
+	header->version = SWEET_GPU_WIRE_VERSION;
+	header->operation = SWEET_GPU_WIRE_TEXMAP;
+	header->request = surface;
+	IOByteCount offset = 0;
+	uint32_t index = 0;
+	addr64_t first = 0;
+	IOReturn result = kIOReturnSuccess;
+	while (offset < s->allocSize && index < total) {
+		IOByteCount length = 0;
+		addr64_t pa = s->memory->getPhysicalSegment(offset, &length, 0);
+		if (pa == 0 || length == 0) {
+			result = kIOReturnIOError;
+			break;
+		}
+		IOByteCount end = offset + length;
+		while (offset < end && index < total) {
+			if (map->page_count == 0) {
+				map->surface = surface;
+				map->page_index = index;
+				map->total_pages = total;
+				map->alloc_lo = (uint32_t)s->allocSize;
+				map->alloc_hi = (uint32_t)((uint64_t)s->allocSize >> 32);
+				map->first_pa_lo = (uint32_t)first;
+				map->first_pa_hi = (uint32_t)(first >> 32);
+				map->page_shift = SWEET_GPU_PAGE_SHIFT;
+			}
+			if (index == 0) {
+				first = pa;
+				map->first_pa_lo = (uint32_t)first;
+				map->first_pa_hi = (uint32_t)(first >> 32);
+			}
+			map->pages[map->page_count++] = pa;
+			index++;
+			offset += SWEET_GPU_PAGE_SIZE;
+			pa += SWEET_GPU_PAGE_SIZE;
+			if (map->page_count == SWEET_GPU_MAP_PAGES || index == total) {
+				header->bytes = (uint32_t)(40 + 8 * map->page_count);
+				result = sweet_gpu_wire_send(message, 16 + header->bytes);
+				map->page_count = 0;
+				if (result != kIOReturnSuccess) {
+					break;
+				}
+			}
+		}
+		if (result != kIOReturnSuccess) {
+			break;
+		}
+	}
+	IOFree(message, message_size);
+	*out_pages = index;
+	*out_first = first;
+	return result;
+}
